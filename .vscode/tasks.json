{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Codegen",
      "type": "shell",
      "command": "cargo xtask codegen",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Build Server",
      "type": "shell",
      "command": "cargo build --package boring_rpc_lsp",
      "dependsOn": ["Codegen"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Build Extension",
      "group": "build",
      "type": "npm",
      "script": "build",
      "path": "packages/boring-rpc-vscode/",
      "problemMatcher": {
        "base": "$tsc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/packages/boring-rpc-vscode/"
        ]
      }
    },
    {
      "label": "Build Server and Extension",
      "dependsOn": ["Build Server", "Build Extension"],
      "problemMatcher": "$rustc"
    }
  ]
}
